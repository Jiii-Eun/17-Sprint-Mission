{
  "compilerOptions": {
    "jsx": "react-jsx",
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.svg"
  ],
  "exclude": ["node_modules", "**/node_modules", "dist"]
}
